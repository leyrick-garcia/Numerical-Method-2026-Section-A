# ==========================================
# 0. ENVIRONMENT SETUP (PREVENT OPENBLAS ERROR)
# ==========================================
import os
os.environ["OPENBLAS_NUM_THREADS"] = "1"
os.environ["MKL_NUM_THREADS"] = "1"
os.environ["OMP_NUM_THREADS"] = "1"
os.environ["VECLIB_MAXIMUM_THREADS"] = "1"
os.environ["NUMEXPR_NUM_THREADS"] = "1"

import json
import numpy as np
import pandas as pd
from scipy.optimize import curve_fit
from scipy import stats
from scipy.integrate import quad, trapezoid

# ==========================================
# STEP 0: DATA INGESTION & TIME AXIS
# ==========================================
xls = pd.ExcelFile('Data_01_Updated.xlsx')
df = pd.read_excel(xls, 'Sensor Log')
data_df = df.iloc[3:].copy()
data_df.columns = ['Reading', 'Timestamp', 'date', 'time', 'Depth']
data_df = data_df.dropna(subset=['Timestamp'])

h = pd.to_numeric(data_df['Depth']).values  # Water depth in meters (288 values)
t = np.arange(len(h)) * 0.25                # Numeric time axis (0.25h steps up to 71.75h)

print(f"Step 0 Complete: Loaded {len(h)} readings from t = {t[0]:.2f} to {t[-1]:.2f} hours.")


# ==========================================
# STEP 1: FINITE-DIFFERENCE DERIVATIVES
# ==========================================
dt = 0.25
dh = np.zeros_like(h)
dh[0] = (h[1] - h[0]) / dt                  # Forward difference (start)
dh[-1] = (h[-1] - h[-2]) / dt               # Backward difference (end)
dh[1:-1] = (h[2:] - h[:-2]) / (2 * dt)      # Central differences (interior)

d2h = np.zeros_like(h)
d2h[1:-1] = (h[2:] - 2*h[1:-1] + h[:-2]) / (dt**2)
d2h[0] = d2h[1]
d2h[-1] = d2h[-2]

max_dh_idx = np.argmax(dh)
max_d2h_idx = np.argmax(np.abs(d2h))
print(f"Step 1 Complete: Max dh/dt = {dh[max_dh_idx]:.4f} m/h at t = {t[max_dh_idx]} hours")


# ==========================================
# STEP 2: MODEL FITTING (LEVENBERG-MARQUARDT)
# ==========================================
def logistic4(t, c, a, k, t0):
    return c + a / (1.0 + np.exp(-k * (t - t0)))

p0 = [h[0], h[-1] - h[0], 0.5, t[len(t)//2]]
popt, pcov = curve_fit(logistic4, t, h, p0=p0, method="lm", maxfev=50000)

se = np.sqrt(np.diag(pcov))

h_fitted = logistic4(t, *popt)
resid = h - h_fitted
sse = np.sum(resid**2)
sst = np.sum((h - h.mean())**2)  # Total Sum of Squares (SST)
r2 = 1 - (sse / sst)
n, p_count = len(h), len(popt)
s_err = np.sqrt(sse / (n - p_count))

print(f"Step 2 Complete: R^2 = {r2:.4f}, SST = {sst:.4f}, Standard Error (s) = {s_err:.4f} m")


# ==========================================
# STEP 3: INTEGRATION (AREA UNDER THE CURVE)
# ==========================================
area_quad, area_err = quad(lambda x: logistic4(x, *popt), t[0], t[-1])
area_trapz = trapezoid(h, t)

print("Step 3 Complete:")
print(f"  - Area under fitted curve (quad): {area_quad:.4f} meter-hours")
print(f"  - Trapezoidal cross-check (raw data): {area_trapz:.4f} meter-hours")


# ==========================================
# STEP 4: STATISTICAL DIAGNOSTICS (t and p values)
# ==========================================
degrees_of_freedom = n - p_count
t_stats = popt / se
p_vals = (1 - stats.t.cdf(np.abs(t_stats), degrees_of_freedom)) * 2

print("Step 4 Complete: Statistical diagnostics calculated.")


# ==========================================
# STEP 5: GENERATE 3-TAB HTML DASHBOARD
# ==========================================
